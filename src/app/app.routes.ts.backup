import { Routes } from '@angular/router';
import { authGuard } from './core/guards/auth.guard';
import { adminGuard } from './core/guards/admin.guard';
import { customerGuard } from './core/guards/customer.guard';

export const routes: Routes = [

  // =========================================================
  // ESPAÑOL
  // =========================================================

  // Inicio
  {
    path: '',
    loadComponent: () =>
      import('./features/home/pages/home-page/home-page.component').then(
        m => m.HomePageComponent
      )
  },

  // Catálogo
  {
    path: 'catalogo',
    loadComponent: () =>
      import('./features/catalog/pages/product-list/product-list.component').then(
        m => m.ProductListComponent
      )
  },
  {
    path: 'catalogo/:id',
    loadComponent: () =>
      import('./features/catalog/pages/product-detail/product-detail.component').then(
        m => m.ProductDetailComponent
      )
  },

  // Carrito
  {
    path: 'carrito',
    canActivate: [customerGuard],
    loadComponent: () =>
      import('./features/cart/pages/cart-page/cart-page.component').then(
        m => m.CartPageComponent
      )
  },

  // Checkout
  {
    path: 'checkout',
    canActivate: [customerGuard],
    loadComponent: () =>
      import('./features/checkout/pages/checkout-page/checkout-page.component').then(
        m => m.CheckoutPageComponent
      )
  },

  // Login
  {
    path: 'login',
    loadComponent: () =>
      import('./features/auth/pages/login/login.component').then(
        m => m.LoginComponent
      )
  },

  // Pedidos
  {
    path: 'pedidos',
    canActivate: [authGuard, customerGuard],
    loadChildren: () =>
      import('./features/orders/orders.routes')
  },

  // Admin
  {
    path: 'admin',
    canActivate: [adminGuard],
    loadChildren: () =>
      import('./features/admin/admin.routes').then(
        m => m.adminRoutes
      )
  },

  // Ayuda
  {
    path: 'sucursales',
    loadComponent: () =>
      import('./features/home/pages/sucursales-page/sucursales-page.component').then(
        m => m.SucursalesPageComponent
      )
  },
  {
    path: 'devoluciones',
    loadComponent: () =>
      import('./features/home/pages/devoluciones-page/devoluciones-page.component').then(
        m => m.DevolucionesPageComponent
      )
  },
  {
    path: 'faq',
    loadComponent: () =>
      import('./features/home/pages/faq-page/faq-page.component').then(
        m => m.FaqPageComponent
      )
  },
  {
    path: 'terminos',
    loadComponent: () =>
      import('./features/home/pages/terminos-page/terminos-page.component').then(
        m => m.TerminosPageComponent
      )
  },
  {
    path: 'envios',
    loadComponent: () =>
      import('./features/home/pages/envios-page/envios-page.component').then(
        m => m.EnviosPageComponent
      )
  },


  // =========================================================
  // ENGLISH
  // =========================================================

  // Home
  {
    path: 'en',
    loadComponent: () =>
      import('./features/home/pages/home-page/home-page.component').then(
        m => m.HomePageComponent
      )
  },

  // Catalog
  {
    path: 'en/catalog',
    loadComponent: () =>
      import('./features/catalog/pages/product-list/product-list.component').then(
        m => m.ProductListComponent
      )
  },
  {
    path: 'en/catalog/:id',
    loadComponent: () =>
      import('./features/catalog/pages/product-detail/product-detail.component').then(
        m => m.ProductDetailComponent
      )
  },

  // Cart
  {
    path: 'en/cart',
    canActivate: [customerGuard],
    loadComponent: () =>
      import('./features/cart/pages/cart-page/cart-page.component').then(
        m => m.CartPageComponent
      )
  },

  // Checkout
  {
    path: 'en/checkout',
    canActivate: [customerGuard],
    loadComponent: () =>
      import('./features/checkout/pages/checkout-page/checkout-page.component').then(
        m => m.CheckoutPageComponent
      )
  },

  // Login
  {
    path: 'en/login',
    loadComponent: () =>
      import('./features/auth/pages/login/login.component').then(
        m => m.LoginComponent
      )
  },

  // Orders
  {
    path: 'en/orders',
    canActivate: [authGuard, customerGuard],
    loadChildren: () =>
      import('./features/orders/orders.routes')
  },

  // Help
  {
    path: 'en/branches',
    loadComponent: () =>
      import('./features/home/pages/sucursales-page/sucursales-page.component').then(
        m => m.SucursalesPageComponent
      )
  },
  {
    path: 'en/returns',
    loadComponent: () =>
      import('./features/home/pages/devoluciones-page/devoluciones-page.component').then(
        m => m.DevolucionesPageComponent
      )
  },
  {
    path: 'en/faq',
    loadComponent: () =>
      import('./features/home/pages/faq-page/faq-page.component').then(
        m => m.FaqPageComponent
      )
  },
  {
    path: 'en/terms',
    loadComponent: () =>
      import('./features/home/pages/terminos-page/terminos-page.component').then(
        m => m.TerminosPageComponent
      )
  },
  {
    path: 'en/shipping',
    loadComponent: () =>
      import('./features/home/pages/envios-page/envios-page.component').then(
        m => m.EnviosPageComponent
      )
  },


  // =========================================================
  // CATCH-ALL
  // =========================================================

  {
    path: '**',
    redirectTo: ''
  }
];